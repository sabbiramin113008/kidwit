[1.8875, "o", "\u001b[1;38;5;205m  █▄▀ █ █▀▄ █ █ █ █ ▀█▀\u001b[0m\r\r\n\u001b[1;38;5;141m  █ █ █ █▄▀ ▀▄▀▄▀ █  █ \u001b[0m\r\r\n\u001b[2mkidwit 0.1.0rc1 in /private/tmp/demo. /clear resets, /undo reverts the last edit, /verbose toggles detail, /exit quits.\u001b[0m\r\r\n\u0001\u001b[1;32m\u0002>> \u0001\u001b[0m\u0002"]
